{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "haibala",
  "version": "0.1.0",
  "identifier": "aii.haibala",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      { "title": "haibala · 签发台", "width": 1280, "height": 860, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../desktop/haibala-icon.png"]
  }
}
